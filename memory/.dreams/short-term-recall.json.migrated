      "startLine": 215,
      "endLine": 215,
      "source": "memory",
      "snippet": "User: 甲和乙各有若干枚金币。若甲给乙10枚，则两人金币数相等。若乙给甲20枚，则甲的金币数将变成乙的3倍。请问：甲和乙原来各有多少枚金币？",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
      "maxScore": 0.58,
      "firstRecalledAt": "2026-05-13T23:49:28.091Z",
      "lastRecalledAt": "2026-05-13T23:49:28.091Z",
      "queryHashes": [
