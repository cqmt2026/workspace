  "hook_templates": {
    "排名悬念": "同是{title}，第一名和最后一名差距有多大？看完这张图你就不意外了。",
    "反常识": "你以为{title}最强的是谁？结果可能让你大跌眼镜。",
    "数字冲击": "{title}最高的地方，数据有多惊人？但这个数字背后有个惊人的秘密。",
    "对比反差": "不靠海不沿江的地方，{title}也能排第一？今天带你看看为什么。",
    "反常识对比": "你以为{a}最强？结果{b}在{topic}上反而赢了，为什么？",
    "身份代入": "所有{target}注意！来看看你的家乡排第几。"
  },
  "outro_templates": {
    "悬念": "还有更猛的数据，关注我下期继续揭秘。",
    "互动": "从{first}到{last}，你觉得哪个最有潜力？评论区投票。",
    "情感": "从{first}到{last}，每个地方都在用自己的方式发展。你最看好谁？",
    "金句": "一句话点破本质：{golden_sentence}"
  },
  "spoken_rules": [
    "长句拆短，每句不超过25字",
    "去除首先其次综上所述等书面连接词",
    "用你咱们代替用户观众",
    "数据加解读各一句不要堆砌",
    "避免据悉据报道据了解等废话",
    "每句结尾用句号不用感叹号",
    "不要用感叹号和问号以外的标点"
  ],
  "density_target_words_per_min": 90,
  "density_min_words_per_min": 75,
  "llm_config": {
    "model": "deepseek-v4-flash",
    "timeout_seconds": 120,
    "fallback_model": "agnes-ai/agnes-2.0-flash"
  }
}
